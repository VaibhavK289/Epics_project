{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Gateway",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/gateway/gateway.js"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Backend",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/backend/app.js"
    },
    {
      "type": "python",
      "request": "launch",
      "name": "Debug ML Service",
      "program": "${workspaceFolder}/ml-service/app.py",
      "console": "integratedTerminal"
    }
  ]
}
